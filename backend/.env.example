APP_ENV=local
APP_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg://social:social@127.0.0.1:5432/social_ops
AUTH_MODE=development
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
ALLOWED_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["127.0.0.1","localhost"]
DEFAULT_TIMEZONE=Australia/Melbourne
LOG_LEVEL=INFO
LOG_JSON=false
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
TIKHUB_BASE_URL=https://api.tikhub.io
TIKHUB_API_KEY=
JOB_LOCK_TIMEOUT_SECONDS=300
WORKER_POLL_SECONDS=1
SCHEDULER_POLL_SECONDS=30
AI_PROVIDER=disabled
AI_MODEL=disabled
AI_PROMPT_VERSION=l1-v1
AI_L1_ESTIMATED_COST_USD=0.05
AI_L2_ESTIMATED_COST_USD=0.20
AI_GENERATION_ESTIMATED_COST_USD=0.15
# Provider API keys are configured through the authenticated settings API.
# Production may inject a base64-encoded 32-byte master key through Secret Store.
AI_CREDENTIALS_ENCRYPTION_KEY=
AI_CREDENTIALS_KEY_FILE=storage/config/.credentials.key
ASR_PROVIDER=disabled
ASR_MODEL=disabled
ASR_ESTIMATED_COST_USD=0.10
# Disabled by default. The dedicated video worker can run independently of TikHub.
VIDEO_TTS_PROVIDER=disabled
VIDEO_TTS_TIMEOUT_SECONDS=60
MINIMAX_API_KEY=
# Optional legacy variable; current MiniMax v2 TTS only requires MINIMAX_API_KEY.
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-hd
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
VIDEO_RUNS_DIR=storage/video-runs
VIDEO_CODEX_BIN=codex
VIDEO_CODEX_TIMEOUT_SECONDS=900
VIDEO_HYPERFRAMES_BIN=npx
VIDEO_HYPERFRAMES_TIMEOUT_SECONDS=900
OBJECT_STORAGE_PROVIDER=disabled
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=ap-southeast-2
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_ADDRESSING_STYLE=auto
MAX_ASSET_SIZE_BYTES=500000000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_OPEN_SECONDS=300
PROVIDER_PAYLOAD_RETENTION_DAYS=90
FAILED_PROVIDER_PAYLOAD_RETENTION_DAYS=30
UNPROMOTED_CONTENT_RETENTION_DAYS=30
